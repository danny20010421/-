rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 存檔：只有本人能讀寫
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 玩家名片：登入的玩家都看得到，只有本人能修改
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // 帳號名稱：只存 uid 與名稱（不存信箱）；註冊前要能確認名稱有沒有被用，所以允許查單一名稱（不能列出全部）
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && !('email' in request.resource.data);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && !('email' in request.resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // 好友關係：只有雙方看得到；由邀請者建立，由對方接受；雙方都能刪除
    match /friendships/{fid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requester
        && request.resource.data.status == 'accepted'
        && request.resource.data.members == resource.data.members
        && request.resource.data.requester == resource.data.requester;
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }
    // 對戰紀錄：只有雙方看得到；只能以自己的名義建立
    match /duels/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.attacker || request.auth.uid == resource.data.defender);
      allow create: if request.auth != null && request.resource.data.attacker == request.auth.uid;
    }
    // 好友禮物：只有送禮與收禮的人看得到；由送禮者建立，收禮者只能把 claimed 改成 true
    match /gifts/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid && request.resource.data.claimed == false;
      allow update: if request.auth != null && request.auth.uid == resource.data.to
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && request.resource.data.claimed == true;
    }
    // 船團：登入的玩家都看得到（搜尋、加入用）；成員可以更新（BOSS 血量、留言板、公告、成員）；非成員只能把自己加進成員名單（最多 20 人）
    match /guilds/{gid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.leader == request.auth.uid && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (request.auth.uid in request.resource.data.members
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && resource.data.members.size() < 20
            && request.resource.data.leader == resource.data.leader
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])));
      allow delete: if request.auth != null && request.auth.uid in resource.data.members && resource.data.members.size() <= 1;
    }
    // 好友留言：只有寫的人與收的人看得到；收到的人可以刪除；最多 80 字
    match /notes/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 80;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
    }
    // 即時對戰房間：公開房間（open: true）登入的玩家都能觀戰；只有雙方能更新；由邀請方（host）建立
    match /rooms/{id} {
      allow read: if request.auth != null && (resource.data.open == true || request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest);
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && (request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest)
        && request.resource.data.host == resource.data.host && request.resource.data.guest == resource.data.guest;
    }
  }
}
